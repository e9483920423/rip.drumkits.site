{
  "name": "media-downloader",
  "version": "1.0.0",
  "description": "Open-source media downloader for YouTube, SoundCloud, Spotify, and other allowlisted yt-dlp sites. Stream files to the browser; nothing is kept on the server.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/e9483920423/rip.drumkits.site.git"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "test": "node --test --test-reporter spec \"tests/*.test.js\""
  },
  "dependencies": {
    "fastify": "^5.6.2",
    "yazl": "^3.3.1"
  }
}
