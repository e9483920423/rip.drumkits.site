{
  "name": "media-downloader",
  "version": "1.0.0",
  "description": "Open-source media downloader for YouTube, SoundCloud, Spotify, and other allowlisted yt-dlp sites. Stream files to the browser; nothing is kept on the server.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/e9483920423/rip.drumkits.site.git"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "test": "node --test --test-reporter spec \"tests/*.test.js\"",
    "vendor:libsonare": "node scripts/vendor-libsonare.js",
    "vendor:audio": "node scripts/vendor-audio.js",
    "postinstall": "node scripts/vendor-libsonare.js && node scripts/vendor-audio.js"
  },
  "dependencies": {
    "@audio/loudness": "^1.3.0",
    "@fastify/multipart": "^10.1.6",
    "@libraz/libsonare": "^1.10.0",
    "fastify": "^5.6.2",
    "mp3tag.js": "^3.17.1",
    "music-metadata": "^12.3.2",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
