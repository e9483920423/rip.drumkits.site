# Bind 0.0.0.0 to reach this host from other devices on your network.
HOST=127.0.0.1
PORT=3000

# Directories are created on startup. Paths are relative to the working directory.
DATA_DIR=./data
DOWNLOAD_DIR=./downloads
DB_PATH=./data/app.db

# Executable names or absolute paths. API requests cannot change these.
YTDLP_PATH=yt-dlp
FFMPEG_PATH=ffmpeg
SPOTDL_PATH=spotdl

# Queue and resource limits.
MAX_CONCURRENT_JOBS=1
MAX_QUEUED_JOBS=10
MAX_FILE_SIZE_MB=500
MAX_PLAYLIST_ENTRIES=100
MAX_ZIP_ITEMS=20
MAX_ZIP_SIZE_MB=2048
MAX_DURATION_SECONDS=7200
JOB_TIMEOUT_SECONDS=1800
FILE_RETENTION_HOURS=24
TEMP_RETENTION_HOURS=6
MAX_JOB_HISTORY=200
CLEANUP_INTERVAL_MINUTES=15
WORKER_SHUTDOWN_SECONDS=10

# HTTP limits.
BODY_LIMIT_BYTES=16384
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_INSPECT_PER_MINUTE=30
RATE_LIMIT_DOWNLOAD_PER_MINUTE=10
MIN_FREE_DISK_MB=512

# Optional. Required on non-loopback binds when set (16-128 characters).
# Send it as X-Access-Token or Authorization: Bearer.
# ACCESS_TOKEN=

# silent, debug, info, warn, or error.
LOG_LEVEL=info
